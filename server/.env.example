# Server Configuration
PORT=5000

# MongoDB Connection (get from MongoDB Atlas dashboard)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# JWT Secret (generate a random string, e.g. using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_secure_random_secret_here
